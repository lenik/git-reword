#!/usr/bin/env python3
"""
Commit message trimmer - removes git commit headers and unindents content.
"""

import argparse
import sys
import os
from typing import List, Tuple


def remove_header(lines: List[str]) -> List[str]:
    """Remove the git commit header (first 4 lines)."""
    if len(lines) >= 4:
        return lines[4:]
    return lines


def find_common_indent(lines: List[str]) -> str:
    """Find the common whitespace prefix across all non-empty lines."""
    non_empty_lines = [line for line in lines if line.strip()]
    if not non_empty_lines:
        return ""
    
    # Find the minimum common prefix
    common_prefix = None
    for line in non_empty_lines:
        # Count leading whitespace
        i = 0
        while i < len(line) and line[i] in ' \t':
            i += 1
        prefix = line[:i]
        
        if common_prefix is None:
            common_prefix = prefix
        else:
            # Find common prefix between current common_prefix and this line's prefix
            j = 0
            while j < min(len(common_prefix), len(prefix)) and common_prefix[j] == prefix[j]:
                j += 1
            common_prefix = common_prefix[:j]
            
            if not common_prefix:
                break
    
    return common_prefix or ""


def unindent_lines(lines: List[str]) -> List[str]:
    """Remove common whitespace prefix from lines while preserving indent structure."""
    common_indent = find_common_indent(lines)
    if not common_indent:
        return lines
    
    unindented = []
    for line in lines:
        if line.startswith(common_indent):
            unindented.append(line[len(common_indent):])
        else:
            unindented.append(line)
    
    return unindented


def process_commit_file(file_path: str) -> str:
    """Process a commit file and return the trimmed content."""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
    except UnicodeDecodeError:
        # Try with different encoding if UTF-8 fails
        with open(file_path, 'r', encoding='latin-1') as f:
            lines = f.readlines()
    
    # Remove header
    lines = remove_header(lines)
    
    # Remove trailing newlines to avoid empty lines at the end
    while lines and lines[-1] == '\n':
        lines.pop()
    
    # Unindent
    lines = unindent_lines(lines)
    
    # Join back into string
    return ''.join(lines)


def main():
    parser = argparse.ArgumentParser(
        description='Remove git commit headers and unindent commit message content'
    )
    parser.add_argument('files', nargs='+', help='Commit message files to process')
    parser.add_argument('-i', '--inplace', action='store_true',
                       help='Edit files in place (default: output to stdout)')
    
    args = parser.parse_args()
    
    for file_path in args.files:
        if not os.path.exists(file_path):
            print(f"Error: File '{file_path}' not found", file=sys.stderr)
            sys.exit(1)
        
        try:
            content = process_commit_file(file_path)
            
            if args.inplace:
                with open(file_path, 'w', encoding='utf-8') as f:
                    f.write(content)
            else:
                if len(args.files) > 1:
                    # Print filename header for multiple files
                    print(f"=== {file_path} ===")
                print(content)
                
                if len(args.files) > 1:
                    print()  # Add blank line between files
                    
        except Exception as e:
            print(f"Error processing '{file_path}': {e}", file=sys.stderr)
            sys.exit(1)


if __name__ == '__main__':
    main()
